# ============================================================
# Local-only datasets and sensitive documents
# ============================================================
# Keep the sample-label directory structure, but do not commit
# real or confidential PDFs.
data/sample_labels/*
!data/sample_labels/.gitkeep

# Keep evaluation datasets version-controlled.
# Do not ignore data/evaluation/questions.jsonl or
# data/evaluation/expected_evidence.jsonl.
