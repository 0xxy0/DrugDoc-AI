# ============================================================================
# DrugDoc AI — environment variable template
# ============================================================================
# Copy to .env for local development.
# Never commit .env or real credentials.
#
# Precedence: environment variables > configs/config.yaml > Settings defaults
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DRUGDOC_ENVIRONMENT=development
DRUGDOC_DEBUG=false
DRUGDOC_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
DRUGDOC_DATA_DIR=data
DRUGDOC_UPLOAD_DIR=data/uploads
DRUGDOC_SAMPLE_LABELS_DIR=data/sample_labels
DRUGDOC_EVALUATION_DIR=data/evaluation
DRUGDOC_REPORTS_DIR=reports

DRUGDOC_EVALUATION_QUESTIONS_FILE=data/evaluation/questions.jsonl
DRUGDOC_EXPECTED_EVIDENCE_FILE=data/evaluation/expected_evidence.jsonl

# ---------------------------------------------------------------------------
# Document ingestion
# ---------------------------------------------------------------------------
DRUGDOC_MAX_UPLOAD_SIZE_MB=25
DRUGDOC_ALLOWED_EXTENSIONS=.pdf
DRUGDOC_OCR_ENABLED=true
DRUGDOC_OCR_LANGUAGE=eng
DRUGDOC_MIN_TEXT_CHARACTERS_PER_PAGE=40

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# Options: fixed | semantic
DRUGDOC_CHUNKING_STRATEGY=fixed
DRUGDOC_CHUNK_SIZE=900
DRUGDOC_CHUNK_OVERLAP=150
DRUGDOC_SEMANTIC_MIN_CHUNK_CHARS=250
DRUGDOC_SEMANTIC_MAX_CHUNK_CHARS=1400

DRUGDOC_CHUNK_SUMMARIZATION_ENABLED=false
DRUGDOC_CHUNK_SUMMARY_MAX_TOKENS=80

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
DRUGDOC_EMBEDDING_MODEL=BAAI/bge-m3
DRUGDOC_EMBEDDING_DEVICE=cpu
DRUGDOC_EMBEDDING_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
DRUGDOC_DENSE_RETRIEVAL_ENABLED=true
DRUGDOC_SPARSE_RETRIEVAL_ENABLED=true

DRUGDOC_RETRIEVAL_TOP_K=5
DRUGDOC_DENSE_CANDIDATE_K=10
DRUGDOC_SPARSE_CANDIDATE_K=10
DRUGDOC_RRF_K=60
DRUGDOC_MIN_EVIDENCE_SCORE=0.0

DRUGDOC_RETRIEVAL_MULTI_QUERY_ENABLED=true
DRUGDOC_RETRIEVAL_MULTI_QUERY_COUNT=3

DRUGDOC_RETRIEVAL_RECURSIVE_ENABLED=true
DRUGDOC_RETRIEVAL_RECURSIVE_DEPTH=2
DRUGDOC_RETRIEVAL_RECURSIVE_MIN_CHUNKS=3

DRUGDOC_RETRIEVAL_MMR_ENABLED=true
DRUGDOC_RETRIEVAL_MMR_LAMBDA=0.7

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
DRUGDOC_VECTOR_STORE_TYPE=qdrant_local
DRUGDOC_QDRANT_PATH=data/qdrant
DRUGDOC_QDRANT_URL=http://localhost:6333
# Leave blank for local development without authentication.
DRUGDOC_QDRANT_API_KEY=
DRUGDOC_QDRANT_COLLECTION=drugdoc_labels

# ---------------------------------------------------------------------------
# LLM provider: ollama | openai
# ---------------------------------------------------------------------------
DRUGDOC_LLM_PROVIDER=ollama

# Ollama
DRUGDOC_OLLAMA_BASE_URL=http://localhost:11434
DRUGDOC_OLLAMA_MODEL=llama3.1:8b

# OpenAI
DRUGDOC_OPENAI_MODEL=gpt-4o-mini
# Real OpenAI keys must only be provided through the environment.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
DRUGDOC_LLM_TEMPERATURE=0.0
DRUGDOC_LLM_MAX_TOKENS=900
DRUGDOC_LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Answer safety and verification
# ---------------------------------------------------------------------------
DRUGDOC_ABSTENTION_ENABLED=true
DRUGDOC_REQUIRE_CITATIONS=true
DRUGDOC_MAX_CONTEXT_CHUNKS=5
DRUGDOC_SELF_CORRECTION_ENABLED=true

# ---------------------------------------------------------------------------
# UI-facing behavior
# ---------------------------------------------------------------------------
DRUGDOC_SHOW_RETRIEVAL_TRACE=true
DRUGDOC_ENABLE_ANSWER_COMPARISON=false